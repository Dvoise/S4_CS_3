{
  "title": "SOAR & Hybrid Overview",
  "uid": "soar-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape targets up",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up)",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SOAR events logged",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "soarmysql"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) AS events FROM events"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU % per host (AWS + on-prem)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Events by type",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "soarmysql"
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^count$/"
        },
        "pieType": "pie",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT event_type, COUNT(*) AS count FROM events WHERE $__timeFilter(ts) GROUP BY event_type"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Events over time",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "soarmysql"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,'1m'), event_type AS metric, COUNT(*) AS value FROM events WHERE $__timeFilter(ts) GROUP BY 1,2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Latest SOAR events",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "soarmysql"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts, source, event_type, severity, source_ip FROM events ORDER BY ts DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Lambda invocations (SOAR functions)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cw"
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/Lambda",
          "metricName": "Invocations",
          "dimensions": {
            "FunctionName": "*"
          },
          "matchExact": false,
          "statistic": "Sum",
          "period": "60",
          "id": ""
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Lambda errors (SOAR functions)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cw"
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/Lambda",
          "metricName": "Errors",
          "dimensions": {
            "FunctionName": "*"
          },
          "matchExact": false,
          "statistic": "Sum",
          "period": "60",
          "id": ""
        }
      ]
    }
  ]
}